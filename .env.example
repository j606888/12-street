# Database (app runtime, least-privilege role in production)
DATABASE_URL=postgres://photo:photo@localhost:5433/photo
# Migrations (DDL role in production; falls back to DATABASE_URL)
MIGRATION_DATABASE_URL=
# "true" in production: verify RDS TLS with certs/rds-global-bundle.pem
DATABASE_SSL=

# Better Auth
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# LINE Login channel
LINE_CLIENT_ID=
LINE_CLIENT_SECRET=
# LIFF app under the same LINE Login channel (endpoint: production URL); signs in automatically inside LINE
NEXT_PUBLIC_LIFF_ID=

# Messaging API channel of the official account (same provider as the LINE Login channel).
# /api/line/webhook verifies requests with the secret (rejects all when unset) and replies with the long-lived token
LINE_MESSAGING_CHANNEL_SECRET=
LINE_MESSAGING_ACCESS_TOKEN=

# Comma-separated LINE user IDs promoted to admin by db:seed
ADMIN_LINE_IDS=

# Cloudflare R2
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# Payment info shown at checkout (values: docs/owner-pricing.md). LINE ID is optional when the URL is set.
# Bank account: use "\n" inside double quotes for line breaks, e.g. "玉山銀行（808）\n戶名：…\n帳號：…"
NEXT_PUBLIC_LINE_PAY_ID=
NEXT_PUBLIC_LINE_PAY_URL=
NEXT_PUBLIC_BANK_ACCOUNT=

# Vercel Cron auth (16+ chars; /api/cron/cleanup rejects every request when unset)
# openssl rand -base64 32
CRON_SECRET=

# Order notification emails via Resend (sending is skipped when either is unset)
# RESEND_API_KEY comes from the Vercel Marketplace integration
RESEND_API_KEY=
# Sender on the verified domain, e.g. "十二街影像生活館 <noreply@12-street.com>"
EMAIL_FROM=
# Optional: where customer replies go (12-street.com has no inbox)
EMAIL_REPLY_TO=
